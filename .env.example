# Copy this file to .env and edit the copy. Never commit .env.
# Settings are read from environment variables prefixed with QA_.
# Nothing secret belongs in this example file.
QA_APP_ENV=development
QA_LOG_LEVEL=INFO

# MongoDB (defaults suit a local, unauthenticated MongoDB on this computer).
# If the connection string contains a password, put it only in your private .env.
# QA_MONGODB_URI=mongodb://127.0.0.1:27017
# QA_MONGODB_DB=qa_agent

# DeepSeek API key (needed when test case generation is added).
# QA_DEEPSEEK_API_KEY=